    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst unsentLeads = items.filter(item => {\n  const status = String(item.json.report_status || \"\").trim().toLowerCase();\n  return status !== \"sent\";\n});\n\nconst leadsData = unsentLeads.map((item, index) => {\n  return `LEAD ${index + 1}:\nName: ${item.json.name || \"\"}\nEmail: ${item.json.email || \"\"}\nCompany: ${item.json.company_name || \"\"}\nCompany Size: ${item.json.company_size || \"\"}\nCountry: ${item.json.country || \"\"}\nIndustry: ${item.json.industry || \"\"}\nBudget: ${item.json.estimated_budget || \"\"}\nProject Description: ${item.json.project_description || \"\"}\nInterested: ${item.json.interested || \"\"}`;\n}).join(\"\\n\\n-------------------\\n\\n\");\n\nreturn [{\n  json: {\n    leads_data: leadsData,\n    processed_rows: unsentLeads.map(item => ({\n      row_number: item.json.row_number\n    }))\n  }\n}];"
      },
